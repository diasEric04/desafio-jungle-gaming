# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL ---
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- AWS / SQS (LocalStack) ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

# --- Roles (an instance can run any subset) ---
ENABLE_QUEUE_CONSUMER=true
ENABLE_OUTBOX_PUBLISHER=true
ENABLE_PENDING_REFERENCE_WORKER=true

# --- Queue consumer ---
CONSUMER_CONCURRENCY=5
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
CONSUMER_WAIT_SECONDS=5
CONSUMER_RETRY_BASE_SECONDS=2

# --- Outbox publisher ---
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=25

# --- Pending-reference worker (out-of-order references) ---
PENDING_REFERENCE_POLL_INTERVAL_MS=2000
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_MAX_ATTEMPTS=8
PENDING_REFERENCE_BASE_DELAY_MS=5000
PENDING_REFERENCE_MAX_DELAY_MS=120000
PENDING_REFERENCE_TTL_SECONDS=600

# --- Shutdown ---
SHUTDOWN_TIMEOUT_MS=20000

# --- Fault injection (never in production; used by crash-recovery tests) ---
FAULT_EXIT_BEFORE_ACK=false

# --- Database tuning ---
DB_LOCK_TIMEOUT_MS=5000
DB_TX_MAX_RETRIES=3

# --- Outbox backoff ---
OUTBOX_BASE_DELAY_MS=1000
OUTBOX_MAX_DELAY_MS=60000

# --- Pending-reference lease ---
PENDING_REFERENCE_LEASE_SECONDS=30

# --- Consumer retry / identity ---
CONSUMER_NAME=wager-transactions-consumer
CONSUMER_RETRY_MAX_SECONDS=120
INSTANCE_ID=local

# --- Fault injection (crash-recovery tests only) ---
FAULT_EXIT_AFTER_PUBLISH=false
